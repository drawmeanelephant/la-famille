# La Famille has no required environment variables for local build, test, or
# preview commands.
#
# Optional GitHub automation:
# GITHUB_TOKEN=                 # required only for `la-famille pr sync`
#
# GitHub Pages uses repository variables rather than a local .env file:
# SITE_URL=https://example.github.io/la-famille
# LA_FAMILLE_VERSION=v0.1.0-prealpha
